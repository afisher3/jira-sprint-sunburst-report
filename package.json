  "description": "Automated tool that pulls Jira data and produces interactive sunburst reports",
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "test": "vitest",
    "test:watch": "vitest --watch"
  },
  "keywords": [
    "jira",
    "reporting",
    "sunburst",
    "sprint"
  ],
  "files": [ 
    "dist",
    "config/config.local.yaml"
