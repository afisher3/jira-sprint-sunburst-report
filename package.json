  "author": "",
  "license": "MIT",
  "dependencies": {
    "aws-cdk": "^2.1129.0",
    "pino": "^9.5.0",
    "yaml": "^2.6.1",
    "zod": "^3.24.1",
    "@aws-sdk/client-secrets-manager": "^3.1086.0",
    "aws-sdk": "^2.1693.0",
    "@aws-sdk/client-s3": "3.1086.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
